{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noEmitOnError": true,
    "strictNullChecks": true,
    "noUnusedLocals": true
  },
  "compileOnSave": true,
  "include": [
    "src/**/*"
, "src/db.ts"  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}